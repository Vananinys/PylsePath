<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/steps_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="6dp" android:background="@drawable/steps_widget_blue_background">
 <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/steps_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ШАГИ СЕГОДНЯ" android:textColor="#B9DCFF" android:textSize="11sp" android:maxLines="1" />
  <TextView android:id="@+id/steps_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PulsePath" android:textColor="#C1CFDF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
 </LinearLayout>
 <TextView android:id="@+id/steps_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="0" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" />
</LinearLayout>
